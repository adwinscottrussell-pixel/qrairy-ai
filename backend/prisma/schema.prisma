generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model QR {
  id           String       @id @default(uuid())
  originalUrl  String
  businessName String?
  createdAt    DateTime     @default(now())
  scans        Scan[]
  subscribers  Subscriber[]
}

model Scan {
  id        String   @id @default(uuid())
  qrId      String
  userAgent String
  createdAt DateTime @default(now())
  qr        QR       @relation(fields: [qrId], references: [id])
}

model Subscriber {
  id            String   @id @default(uuid())
  qrId          String
  oneSignalId   String
  createdAt     DateTime @default(now())
  qr            QR       @relation(fields: [qrId], references: [id])
}