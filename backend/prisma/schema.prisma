generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id
  email     String?
  phone     String?
  plan      String   @default("free")
  createdAt DateTime @default(now())
  stripeCustomerId     String?
  stripeSubscriptionId String?
  subscriptionStatus   String?
  qrs       QR[]
}

model QR {
  id             String       @id @default(uuid())
  originalUrl    String
  businessName   String?
  siteContent    String?
  userId         String?
  isDynamic      Boolean      @default(false)
  destinationUrl String?
  createdAt      DateTime     @default(now())
  user           User?        @relation(fields: [userId], references: [id])
  scans          Scan[]
  subscribers    Subscriber[]
}

model Scan {
  id        String   @id @default(uuid())
  qrId      String
  userAgent String
  createdAt DateTime @default(now())
  qr        QR       @relation(fields: [qrId], references: [id])
}

model Subscriber {
  id          String   @id @default(uuid())
  qrId        String
  oneSignalId String
  createdAt   DateTime @default(now())
  qr          QR       @relation(fields: [qrId], references: [id])
}

model LandingPage {
  id           String   @id @default(uuid())
  slug         String   @unique
  businessName String
  websiteUrl   String?
  useCase      String?
  brandColor   String?  @default("#ff5a1f")
  logoUrl      String?
  userId       String?
  qrType       String?  @default("ai")
  sections     String?
  status       String   @default("live")
  scanCount    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
}
