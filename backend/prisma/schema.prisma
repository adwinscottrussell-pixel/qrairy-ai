generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String    @id
  email                String?
  phone                String?
  plan                 String    @default("free")
  createdAt            DateTime  @default(now())
  trialExpiresAt       DateTime?
  accountType          String?   @default("free")
  stripeCustomerId     String?
  stripeSubscriptionId String?
  subscriptionStatus   String?
  qrs                  QR[]

  @@index([email])
}

model QR {
  id             String       @id @default(uuid())
  originalUrl    String
  businessName   String?
  siteContent    String?
  userId         String?
  isDynamic      Boolean      @default(false)
  destinationUrl String?
  createdAt      DateTime     @default(now())
  user           User?        @relation(fields: [userId], references: [id])
  lastScannedAt  DateTime?
  scans          Scan[]
  subscribers    Subscriber[]

  @@index([businessName])
}

model Scan {
  id        String   @id @default(uuid())
  qrId      String
  userAgent String
  ip        String?
  referer   String?
  createdAt DateTime @default(now())
  qr        QR       @relation(fields: [qrId], references: [id])
}

model Subscriber {
  id              String    @id @default(uuid())
  qrId            String?
  slug            String?
  oneSignalId     String?
  email           String?
  gdprConsent     Boolean   @default(false)
  userId          String?
  status          String    @default("subscribed")
  source          String    @default("email")
  subscribedAt    DateTime  @default(now())
  unsubscribedAt  DateTime?
  resendContactId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt
  qr              QR?       @relation(fields: [qrId], references: [id])

  @@index([slug])
  @@index([userId])
  @@index([status])
}

model LandingPage {
  id           String   @id @default(uuid())
  slug         String   @unique
  businessName String
  websiteUrl   String?
  useCase      String?
  brandColor   String?  @default("#ff5a1f")
  logoUrl      String?
  userId       String?
  qrType       String?  @default("ai")
  sections     String?
  template     String?
  status       String   @default("live")
  scanCount    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  // Stadt Pocket Phase 1A (2026-08-16) — additive, nullable, optional link
  // to the new Business entity. NOT a replacement for `userId` above:
  // `userId` remains the sole ownership field every existing query/route
  // uses unchanged. `businessId` is populated later by an explicit,
  // reviewed backfill projection (see
  // docs/architecture/NETWORK_LOCATION_FOUNDATION.md) — never required,
  // never read by any current route.
  businessId String?
  business   Business? @relation(fields: [businessId], references: [id])

  @@index([businessName])
  @@index([businessId])
}

model Pass {
  id            String             @id @default(cuid())
  serialNumber  String             @unique
  // Set at creation time. serialNumber encodes slug + an optional customer
  // cid as "sqr-{slug}-{cid}", but slugs themselves contain hyphens, so
  // reverse-parsing the slug back out of serialNumber is ambiguous —
  // storing it directly is the only reliable way to look up which
  // landing page a given Pass belongs to.
  slug          String?
  passTypeId    String
  authToken     String?
  lastMsgTitle  String?
  lastMsg       String?
  lastMsgLink   String?
  stampCount    Int                @default(0)
  stampGoal     Int                @default(10)
  rewardReady   Boolean            @default(false)
  totalStamps   Int                @default(0)
  rewardsEarned Int                @default(0)
  lastStampAt   DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @default(now()) @updatedAt
  devices       PassDevice[]
  registrations PassRegistration[]
  rewardEvents  RewardEvent[]
}

model PassDevice {
  id              String   @id @default(cuid())
  deviceLibraryId String
  pushToken       String
  walletType      String   @default("apple")
  passId          String
  pass            Pass     @relation(fields: [passId], references: [id])
  createdAt       DateTime @default(now())

  @@unique([passId, deviceLibraryId])
}

model PassRegistration {
  id              String   @id @default(cuid())
  deviceLibraryId String
  serialNumber    String
  passId          String
  pass            Pass     @relation(fields: [passId], references: [id])
  createdAt       DateTime @default(now())
}

model PushCampaign {
  id        String   @id @default(cuid())
  slug      String
  title     String
  message   String
  linkUrl   String?
  sent      Int      @default(0)
  createdAt DateTime @default(now())
}

model WebPushSubscription {
  id        String   @id @default(uuid())
  slug      String
  endpoint  String   @unique
  p256dh    String
  auth      String
  // Schema-representation fix only: migration 20260718000000_add_webpush_
  // subscription_cid already applied this nullable column to the real
  // production database; schema.prisma just never caught up. No new
  // migration created here — see docs/architecture/CUSTOMER_FOUNDATION.md.
  cid       String?
  createdAt DateTime @default(now())

  @@index([cid])
}

model StampSettings {
  id         String   @id @default(cuid())
  slug       String   @unique
  goal       Int      @default(10)
  rewardName String   @default("Free item")
  enabled    Boolean  @default(false)
  color      String   @default("#ff5a1f")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt
}

model StampToken {
  id        String   @id @default(cuid())
  slug      String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model StampEntry {
  id        String   @id @default(cuid())
  slug      String
  passId    String
  source    String?
  createdAt DateTime @default(now())
}

model RewardEvent {
  id         String    @id @default(cuid())
  slug       String
  passId     String
  pass       Pass      @relation(fields: [passId], references: [id])
  rewardText String
  status     String    @default("earned")
  createdAt  DateTime  @default(now())
  redeemedAt DateTime?
}

model LoyaltyCustomer {
  id            String    @id @default(cuid())
  slug          String
  customerId    String
  hasWallet     Boolean   @default(false)
  stampCount    Int       @default(0)
  totalStamps   Int       @default(0)
  rewardsEarned Int       @default(0)
  rewardReady   Boolean   @default(false)
  lastStampAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([slug, customerId])
}

// Durable audit log for privileged Operations Center actions (SP3.1).
// metadata is sanitized at the service layer before it ever reaches this
// table — never store passwords, tokens, secrets, cookies, session ids,
// or unnecessary personal data here.
model SupportAction {
  id         String   @id @default(cuid())
  actorId    String
  actorType  String
  actionType String
  targetType String
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

// ============================================================
// Canonical Customer Foundation — Phase 1 (infrastructure only, 2026-08-15).
//
// Corrects an earlier draft of this same foundation (2026-08-11) that
// anchored Customer ownership to `slug` (one landing page). That draft
// was never applied to production and is superseded entirely by this
// version — re-anchored to `ownerUserId` (the authenticated business
// owner / Clerk User.id), which is today's REAL tenant boundary
// (LandingPage.userId), not a single page. This is also the smallest
// upgrade path to the future Brand -> Locations -> Landing Pages
// hierarchy (ADR-004): ownerUserId today is exactly who a future
// Brand's owner would be, so promoting it to a brandId later is a
// straightforward swap, not a redesign. `slug` is kept only as
// optional first-touch/source context, never as the ownership anchor.
//
// Phase 1 is additive infrastructure only:
//   - no customerId/customerRecordId FK added to any existing model
//     (Subscriber, WebPushSubscription, Pass, LoyaltyCustomer,
//     StampEntry, Scan, DealClaim) — that is a later, separate phase
//   - no backfill, no dual-write, no existing behavior changed
//   - CustomerConsent is intentionally NOT part of this targeted
//     deployment (deploy/customer-foundation-phase1-4) — it ships
//     separately, on its own schedule, on the development branch this
//     was cherry-picked from
//
// CustomerChannel (from the superseded draft) is renamed to
// CustomerIdentity here rather than kept as a second, overlapping
// concept — confirmed safe: zero application code referenced
// `prisma.customerChannel` anywhere, so this is a pure rename plus the
// ownerUserId correction, not a breaking change to anything live.
// ============================================================
model Customer {
  id String @id @default(cuid())

  // Tenant anchor. The authenticated business owner (Clerk User.id).
  // Required — every Customer must belong to exactly one business from
  // the moment it's created. This, not slug, is what guarantees
  // customers from different businesses can never collide, and it's
  // what lets one Customer span multiple landing pages owned by the
  // same business.
  ownerUserId String

  // Optional first-touch/source context only — which landing page this
  // identity was first seen on. Never used to decide ownership or
  // collision; ownerUserId alone governs that. Nullable because a
  // future non-page-sourced Customer (e.g. an external CRM import)
  // won't have one.
  slug String?

  displayName            String?
  primaryEmail           String?
  primaryEmailVerifiedAt DateTime?

  status       String  @default("active") // active | merged | anonymized | deleted
  mergedIntoId String?
  source       String?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt
  firstSeenAt    DateTime  @default(now())
  lastActivityAt DateTime?

  identities CustomerIdentity[]

  // Scoped per business, not global — the same real person who is a
  // customer of two unrelated QRAIVY businesses must never collide into
  // one Customer row. NULL primaryEmail values are exempt from this
  // constraint (standard SQL NULL semantics), so many identity-only
  // Customers with no email yet can coexist.
  @@unique([ownerUserId, primaryEmail])
  @@index([ownerUserId])
  @@index([slug])
  @@index([primaryEmail])
}

model CustomerIdentity {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  // Denormalized from the owning Customer, not independently settable —
  // same reasoning as every other tenant-scoped table in this schema.
  // This is what makes the collision guarantee a real DB constraint
  // (below), not just an application-level convention.
  ownerUserId String

  // Optional context: which landing page this specific identity value
  // was captured on. Not part of the uniqueness/collision guarantee —
  // ownerUserId alone governs that, so the same cid/email seen on two
  // different pages owned by the SAME business correctly resolves to
  // one identity row instead of two.
  slug String?

  type       String // "cid" | "email" | "wallet_serial" | "push_endpoint" | "phone" | "whatsapp" | "external_crm"
  // No rows exist yet — Phase 1 creates the table only.
  value      String
  verified   Boolean   @default(false)
  verifiedAt DateTime?
  source     String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now()) @updatedAt

  // Scoped per business (ownerUserId), not per page and not global —
  // the same cid/email appearing on two pages of the SAME business
  // correctly collides into one row (a real same-person signal); the
  // same value appearing under two DIFFERENT businesses never collides
  // (cross-tenant safety), since cid itself is a shared-browser token
  // with no tenant awareness at generation time (see
  // docs/architecture/CUSTOMER_FOUNDATION.md).
  @@unique([ownerUserId, type, value])
  @@index([customerId])
  @@index([slug])
}

// ============================================================
// Network + Location + Business — Stadt Pocket Phase 1A, additive data
// foundation only (2026-08-16). See
// docs/architecture/NETWORK_LOCATION_FOUNDATION.md for the full design.
//
// This layer sits ABOVE Customer Foundation, not inside it. Nothing above
// this comment is touched, and Customer.ownerUserId / CustomerIdentity.
// ownerUserId keep their exact current meaning and scoping — unchanged.
//
// Business is the new canonical tenant entity, deliberately separate from
// the Clerk User (authenticated principal). `Business.primaryOwnerUserId`
// is the SAME value already used everywhere as ownerUserId/userId — kept
// as a bare column (not a Prisma relation), matching the existing
// LandingPage.userId convention: this schema has never modeled `User` as
// a Prisma relation target, so this doesn't invent a new pattern.
//
// Legacy ownerUserId/userId scoping remains authoritative on every
// existing table during this compatibility period — nothing here is
// required, nothing here is read by any existing route yet.
// ============================================================

model Network {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  // "city_network" | "mall_group" | "generic" — free-text by design, same
  // convention as every other type/status column in this schema (e.g.
  // LandingPage.qrType, Customer.status) — no enum type exists anywhere
  // in this schema; not introducing one here.
  type      String   @default("generic")
  status    String   @default("active") // active | paused
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  locations      Location[]
  networkMembers NetworkMember[]
  managerInvites ManagerInvite[]
}

model Location {
  id        String   @id @default(cuid())
  networkId String
  network   Network  @relation(fields: [networkId], references: [id])
  name      String
  slug      String   @unique
  type      String   @default("generic") // "city" | "mall" | "district" | "generic"
  status    String   @default("active") // active | paused
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  businessLocations           BusinessLocation[]
  networkMembers              NetworkMember[]
  cityBusinessInvites         CityBusinessInvite[]
  stadtPocketListingLocations StadtPocketListingLocation[]
  managerInvites              ManagerInvite[]

  @@index([networkId])
}

model Business {
  id   String  @id @default(cuid())
  name String
  // Nullable — unlike LandingPage.slug, most Businesses (especially the
  // compatibility-backfill shim rows for existing accounts) have no
  // natural public slug to assign; never inventing one.
  slug String? @unique

  // The canonical scoping anchor for backward compatibility: the exact
  // same Clerk user id already used as ownerUserId/userId everywhere else
  // in this schema. Every existing single-owner account maps to exactly
  // one Business with primaryOwnerUserId = that account's own id.
  primaryOwnerUserId String

  status    String   @default("active") // active | paused | archived
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  members           BusinessMember[]
  businessLocations BusinessLocation[]
  landingPages      LandingPage[]

  // Reverse side of StadtPocketListing.businessId — additive, optional.
  // A StadtPocketListing exists and is independently publishable with NO
  // Business at all; this relation is only ever populated by a future
  // claim/link step (not part of this phase). Business itself carries no
  // awareness of StadtPocket beyond this one optional pointer — no
  // ownership/identity field above is touched by this relation.
  stadtPocketListing StadtPocketListing?

  @@index([primaryOwnerUserId])
}

model BusinessMember {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  userId     String // Clerk user id
  role       String   @default("owner") // "owner" | "staff"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  // The same Clerk user can never accidentally receive duplicate
  // membership in the same Business.
  @@unique([businessId, userId])
  @@index([userId])
}

// Join: which Location(s) a Business participates in. A Location has many
// Businesses; a Business may participate in multiple Locations (this is
// also how a future multi-outlet brand — ADR-004's Brand -> Locations
// direction — is represented, without a second competing hierarchy: a
// Business with several BusinessLocation rows IS a multi-outlet brand).
// Minimum relationship only — no promotional/billing fields yet.
model BusinessLocation {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  locationId String
  location   Location @relation(fields: [locationId], references: [id])
  status     String   @default("active") // active | paused
  joinedAt   DateTime @default(now())

  // Reverse side of StadtPocketListingLocation.businessLocationId —
  // additive, optional. A StadtPocketListingLocation (physical storefront)
  // exists and is independently publishable with NO BusinessLocation at
  // all; this relation is only ever populated by a future claim/link step
  // (not part of this phase).
  stadtPocketListingLocation StadtPocketListingLocation?

  @@unique([businessId, locationId])
  @@index([locationId])
}

// Future permission relationship (data structure only — no middleware
// reads this yet, see docs/architecture/NETWORK_LOCATION_FOUNDATION.md).
// locationId = null means network-wide access (e.g. Stadt Pocket HQ);
// locationId set means access scoped to exactly that one Location (e.g. a
// single city manager). Known limitation, documented rather than silently
// left unhandled: Postgres unique constraints do not deduplicate multiple
// rows sharing the same (userId, networkId) when locationId is NULL (NULL
// is never equal to NULL) — enforcing "at most one network-wide grant per
// user" is deferred to the Phase 3 service layer that actually creates
// these rows, not solved with a partial index here, to avoid enabling a
// new Prisma preview feature for a case with no real-world duplicate-
// grant risk (redundant, not insecure) this early.
model NetworkMember {
  id         String    @id @default(cuid())
  userId     String // Clerk user id
  networkId  String
  network    Network   @relation(fields: [networkId], references: [id])
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id])
  role       String // "network_admin" | "location_manager"
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt

  @@unique([userId, networkId, locationId])
  @@index([userId])
  @@index([networkId])
}

// ============================================================
// CityBusinessInvite — Stadt Pocket Phase 3B Step 3A (additive only).
// See docs from the Phase 3B Step 3 architecture review.
//
// A City-Manager-initiated invitation for a merchant with no existing
// QRAIVY presence. Deliberately NOT a BusinessLocation row: a
// BusinessLocation requires a real businessId to point at, and no
// canonical Business exists yet at invite time -- creating one before a
// real owner has authenticated would either orphan it permanently or
// require an ownership-transfer mechanism this schema does not have
// (Business.primaryOwnerUserId is set once, at creation, and never
// reassigned by any existing code path). This model is upstream of
// BusinessLocation, never a competing/parallel membership concept: on
// claim, the existing networkAdminService.createBusiness() is called
// with the real owner's User.id (never the inviting manager's), and
// only then is a real BusinessLocation row created.
//
// status is free-text, matching every other status column in this
// schema (Business.status, BusinessLocation.status, Network/Location
// .status) -- no enum type exists anywhere here, not introducing one:
// "pending" | "cancelled" | "claimed" | "expired".
//
// tokenHash only -- the raw claim token is never persisted, matching
// standard practice for any credential-bearing secret; only a
// comparable hash is stored. Verifying a presented token means hashing
// it the same way and comparing tokenHash, never storing/looking up
// the raw value.
//
// claimedBusinessId is set only once claim actually happens (a later
// step) -- Step 3A never populates it; included now so the eventual
// claim step is an additive UPDATE, not a second migration.
model CityBusinessInvite {
  id         String   @id @default(cuid())
  locationId String
  location   Location @relation(fields: [locationId], references: [id])

  businessName String
  email        String

  status String @default("pending") // pending | cancelled | claimed | expired

  tokenHash String @unique

  createdBy String // manager's Clerk userId

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  expiresAt DateTime

  claimedBusinessId String? // set only at claim time (future step) -- null throughout Step 3A

  @@index([locationId])
  @@index([email])
}

// ============================================================
// ManagerInvite — Phase 6D.1 (additive only).
//
// A Global-Admin-initiated invitation for a prospective StadtPocket City
// Manager (or network-wide manager), mirroring CityBusinessInvite's exact
// pattern above (own header comment applies equally here): tokenHash only
// -- the raw invite token is never persisted, only a comparable hash;
// status is free-text matching every other status column in this schema
// ("pending" | "cancelled" | "accepted" | "expired"); no enum type
// introduced.
//
// Deliberately NOT itself a NetworkMember row: authorization must never
// be granted merely because an invite exists or a token is known --
// accepting an invite is a separate, explicit, server-verified step
// (managerInviteService.acceptInvite) that creates the real NetworkMember
// row via the existing networkAdminService.assignManager(), the same
// function /admin/managers already uses for a manually-assigned manager.
// This table is upstream of NetworkMember, never a competing/parallel
// role source -- NetworkMember remains the sole authority
// requireManagerScope/requireStadtpocketWriteScope actually read.
//
// locationId is nullable: null means a network-wide ("network_admin")
// invite, non-null means a single-city ("location_manager") invite --
// same shape networkAdminService.assignManager()/NetworkMember already
// use, not a new convention.
//
// acceptedByUserId/acceptedNetworkMemberId are set only once, at accept
// time -- an audit trail of who accepted and which real membership row
// resulted, never used to grant access by themselves (status +
// tokenHash + the atomic pending->accepted transition are what actually
// gate the accept -- see managerInviteService.js).
model ManagerInvite {
  id         String    @id @default(cuid())
  email      String
  name       String?
  networkId  String
  network    Network   @relation(fields: [networkId], references: [id])
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id])
  role       String // "network_admin" | "location_manager" -- same MANAGER_ROLES set as NetworkMember.role

  status String @default("pending") // pending | cancelled | accepted | expired

  tokenHash String @unique

  createdBy String // inviting Global Admin's Clerk userId

  acceptedByUserId        String? // set only at accept time
  acceptedNetworkMemberId String? // set only at accept time -- points at the resulting NetworkMember row

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  expiresAt DateTime

  @@index([email])
  @@index([networkId])
  @@index([locationId])
}

// ============================================================
// StadtPocketListing — Independent StadtPocket Listing Foundation, Phase 1
// (additive only). Replaces the earlier, never-deployed
// StadtPocketBusinessProfile design (see the "Independent StadtPocket
// Listing architecture" review this migration implements).
//
// Root entity, NOT a satellite of Business. A StadtPocketListing exists
// and is independently publishable with no Business at all -- this is
// the direct fix for the "pre-owner import" problem: a real local
// business can be entered and published on StadtPocket before its owner
// has ever joined QRAIVY, and without fabricating any ownership to make
// that possible. businessId is nullable and is only ever populated by a
// future claim/link step (explicitly not part of this phase) -- claiming
// CONNECTS this row to a real Business, it never copies this row's
// content into a second source of truth, and it never changes this row's
// own id/slug, so the public URL is stable before and after claim.
//
// slug lives HERE (not derived from Business.slug) precisely so it
// remains stable regardless of whether/when a claim ever happens --
// Business.slug is a separate, unrelated QRAIVY-internal concern.
//
// website is intentionally NOT here (see StadtPocketListingLocation) --
// a multi-location brand may have different booking/menu/store URLs per
// storefront.
//
// Not included in this phase: logoUrl, coverImage, gallery, rating,
// reviews, deals, loyalty, qraivyLandingUrl. Every one is either
// unpopulated in the real source dataset today, honesty-gated pending a
// genuine data source, or derivable at read-time from an existing
// canonical model instead of being duplicated here. No public "verified"
// field/badge is derived from the provenance columns below -- see their
// own comment.
model StadtPocketListing {
  id   String @id @default(cuid())
  slug String @unique

  name             String
  category         String
  subCategory      String?
  tags             String[] @default([])
  shortDescription String
  longDescription  String?

  // Phase 6D.2 — header/hero image (additive). Brand-level, like the
  // fields above, not per-storefront -- one hero image per business, not
  // per StadtPocketListingLocation. Deliberately a live column, not a
  // draftData-only value: this is the PUBLISHED image, exactly as
  // authoritative as name/category/etc. above, and participates in the
  // exact same generic draft-merge/publish machinery
  // (stadtpocketManagerService.js's LISTING_FIELDS/mergeState/
  // publishListingLocation) -- no separate "publish image" mechanism.
  // Shape: { url, publicId, width, height } (Cloudinary secure_url +
  // public_id + pixel dimensions from the upload response) or null (no
  // image uploaded yet -- never fabricated, never a placeholder).
  // publicId is kept for a future safe-cleanup pass (deleting an
  // orphaned Cloudinary asset once nothing references it) -- not acted
  // on yet in this phase; see stadtPocketHeaderImageService.js's header
  // comment. Every upload gets its own unique Cloudinary public_id
  // (never overwritten), specifically so the currently-published image
  // is never destroyed or replaced at the CDN level just because a new
  // draft image was uploaded -- only Publish promotes draftData's
  // headerImage onto this column.
  headerImage Json?

  // Optional QRAIVY connection -- see the model header comment. Never
  // required for this row to exist, be edited, or be published.
  businessId String?   @unique
  business   Business? @relation(fields: [businessId], references: [id])

  // Internal provenance only -- see the standalone comment on
  // StadtPocketListingLocation's own provenance columns for the full
  // reasoning (identical here). Never read by the public API, never
  // surfaced as an automatic "verified" badge.
  sourceProvider String?
  sourceUrl      String?
  sourceType     String?
  verifiedAt     DateTime?
  verifiedBy     String? // Clerk userId of whoever verified this listing's brand-level facts

  createdBy String // Clerk userId of the Central Control admin / City Manager who created this listing

  // Phase 6C — Secure Draft -> Preview -> Publish write path (additive).
  // Pending brand-level edits (name/category/subCategory/tags/
  // shortDescription/longDescription), stored SEPARATELY from the live
  // columns above so an in-progress edit can never leak through the
  // public API -- stadtpocketPublicService.js never reads this field
  // (it only ever reads the live scalar columns via an explicit
  // field-picking function, never a raw row spread), so this is
  // structurally unreachable from GET /public/stadtpocket/*, not just
  // unreachable by convention. Publishing copies this data onto the
  // live columns above; it is never cleared after publish, so editing
  // continues from the same working copy rather than snapping back to
  // whatever was just published.
  draftData Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  locations StadtPocketListingLocation[]
}

// ============================================================
// StadtPocketListingLocation — Independent StadtPocket Listing
// Foundation, Phase 1 (additive only). Companion to StadtPocketListing
// above; represents ONE physical storefront.
//
// Deliberately NOT unique on (listingId, locationId): a single brand may
// have multiple physical storefronts in the SAME city (e.g. two Ulm
// branches of the same bakery chain on different streets) -- see the
// architecture review's multi-storefront-per-city correction. Duplicate
// prevention for storefronts is an application-level concern (normalized
// address + listing + city + coordinates where available), not a
// database constraint, since no field or combination of fields on this
// row is a genuinely stable, source-verifiable storefront identifier.
//
// locationId is required and direct (not derived through
// businessLocationId) precisely because this row must exist, belong to
// a real city, and be published with NO BusinessLocation at all --
// businessLocationId is nullable and only ever populated by a future
// claim/link step (not part of this phase), at which point it points at
// the real BusinessLocation for this same Business + this same city.
//
// publicationStatus is the ONLY thing that gates public visibility (see
// stadtpocketPublicService.js) -- deliberately independent of
// businessLocationId/ownership state, per the architecture review's
// "publication and ownership are independent" rule. Stored as free-text
// with an application-enforced value set (draft | published | paused |
// archived), matching the exact convention already used by every other
// status column in this schema (Business.status, BusinessLocation.status,
// Network/Location.status, CityBusinessInvite.status) -- no enum type
// exists anywhere in this schema, not introducing one here.
//
// hours is stored as Json rather than a fixed per-day single-range
// shape, specifically so the backend is never constrained to the
// stadtpocket-web renderer's single-range-per-day limitation. Shape: an
// array of one entry per day that has real source-confirmed data (an
// unconfirmed day is simply absent from the array, never invented as
// either open or closed) --
//   { "day": "Mo" | "Di" | "Mi" | "Do" | "Fr" | "Sa" | "So",
//     "closed": true }                                   -- closed day
//   { "day": "...", "intervals": [{ "open": "11:00", "close": "23:00" }] }
//                                                          -- one range
//   { "day": "...", "intervals": [{ "open": "09:30", "close": "14:00" },
//                                  { "open": "17:00", "close": "23:00" }] }
//                                                          -- split shift
//
// Provenance (sourceProvider/sourceUrl/sourceType/verifiedAt/verifiedBy)
// is tracked separately from StadtPocketListing's own copy because
// storefront-level facts (address, hours) are often confirmed from a
// different source, or at a different time, than brand-level facts
// (category, description) -- e.g. address from an official Google
// listing, hours confirmed by phone. Internal only: never read by the
// public API, never surfaced as an automatic "verified" badge.
//
// Not included in this phase: coverImage, gallery (see
// StadtPocketListing's header comment for the full list and reasoning --
// applies equally here).
model StadtPocketListingLocation {
  id         String             @id @default(cuid())
  listingId  String
  listing    StadtPocketListing @relation(fields: [listingId], references: [id])
  locationId String
  location   Location           @relation(fields: [locationId], references: [id])

  address   String
  latitude  Float?
  longitude Float?
  phone     String?
  website   String?
  hours     Json?

  publicationStatus String    @default("draft") // draft | published | paused | archived
  publishedAt       DateTime? // set on first publish; never cleared by pause -- an honest "was ever published" record, not a "currently published" flag (publicationStatus alone is that)

  // Phase 6C — Secure Draft -> Preview -> Publish write path (additive).
  // Pending storefront-level edits (address/latitude/longitude/phone/
  // website/hours), same isolation guarantee as StadtPocketListing's own
  // draftData field above -- see that field's comment for the full
  // reasoning, identical here.
  draftData Json?

  // Optional QRAIVY connection -- see the model header comment. Never
  // required for this row to exist, be edited, or be published.
  businessLocationId String?           @unique
  businessLocation   BusinessLocation? @relation(fields: [businessLocationId], references: [id])

  sourceProvider String?
  sourceUrl      String?
  sourceType     String?
  verifiedAt     DateTime?
  verifiedBy     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([listingId])
  @@index([locationId])
}
