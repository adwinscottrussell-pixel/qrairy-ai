generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String    @id
  email                String?
  phone                String?
  plan                 String    @default("free")
  createdAt            DateTime  @default(now())
  trialExpiresAt       DateTime?
  accountType          String?   @default("free")
  stripeCustomerId     String?
  stripeSubscriptionId String?
  subscriptionStatus   String?
  qrs                  QR[]

  @@index([email])
}

model QR {
  id             String       @id @default(uuid())
  originalUrl    String
  businessName   String?
  siteContent    String?
  userId         String?
  isDynamic      Boolean      @default(false)
  destinationUrl String?
  createdAt      DateTime     @default(now())
  user           User?        @relation(fields: [userId], references: [id])
  lastScannedAt  DateTime?
  scans          Scan[]
  subscribers    Subscriber[]

  @@index([businessName])
}

model Scan {
  id        String   @id @default(uuid())
  qrId      String
  userAgent String
  ip        String?
  referer   String?
  createdAt DateTime @default(now())
  qr        QR       @relation(fields: [qrId], references: [id])
}

model Subscriber {
  id              String    @id @default(uuid())
  qrId            String?
  slug            String?
  oneSignalId     String?
  email           String?
  gdprConsent     Boolean   @default(false)
  userId          String?
  status          String    @default("subscribed")
  source          String    @default("email")
  subscribedAt    DateTime  @default(now())
  unsubscribedAt  DateTime?
  resendContactId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt
  qr              QR?       @relation(fields: [qrId], references: [id])

  @@index([slug])
  @@index([userId])
  @@index([status])
}

model LandingPage {
  id           String   @id @default(uuid())
  slug         String   @unique
  businessName String
  websiteUrl   String?
  useCase      String?
  brandColor   String?  @default("#ff5a1f")
  logoUrl      String?
  userId       String?
  qrType       String?  @default("ai")
  sections     String?
  template     String?
  status       String   @default("live")
  scanCount    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  // Stadt Pocket Phase 1A (2026-08-16) — additive, nullable, optional link
  // to the new Business entity. NOT a replacement for `userId` above:
  // `userId` remains the sole ownership field every existing query/route
  // uses unchanged. `businessId` is populated later by an explicit,
  // reviewed backfill projection (see
  // docs/architecture/NETWORK_LOCATION_FOUNDATION.md) — never required,
  // never read by any current route.
  businessId String?
  business   Business? @relation(fields: [businessId], references: [id])

  @@index([businessName])
  @@index([businessId])
}

model Pass {
  id            String             @id @default(cuid())
  serialNumber  String             @unique
  // Set at creation time. serialNumber encodes slug + an optional customer
  // cid as "sqr-{slug}-{cid}", but slugs themselves contain hyphens, so
  // reverse-parsing the slug back out of serialNumber is ambiguous —
  // storing it directly is the only reliable way to look up which
  // landing page a given Pass belongs to.
  slug          String?
  passTypeId    String
  authToken     String?
  lastMsgTitle  String?
  lastMsg       String?
  lastMsgLink   String?
  stampCount    Int                @default(0)
  stampGoal     Int                @default(10)
  rewardReady   Boolean            @default(false)
  totalStamps   Int                @default(0)
  rewardsEarned Int                @default(0)
  lastStampAt   DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @default(now()) @updatedAt
  devices       PassDevice[]
  registrations PassRegistration[]
  rewardEvents  RewardEvent[]
}

model PassDevice {
  id              String   @id @default(cuid())
  deviceLibraryId String
  pushToken       String
  walletType      String   @default("apple")
  passId          String
  pass            Pass     @relation(fields: [passId], references: [id])
  createdAt       DateTime @default(now())

  @@unique([passId, deviceLibraryId])
}

model PassRegistration {
  id              String   @id @default(cuid())
  deviceLibraryId String
  serialNumber    String
  passId          String
  pass            Pass     @relation(fields: [passId], references: [id])
  createdAt       DateTime @default(now())
}

model PushCampaign {
  id        String   @id @default(cuid())
  slug      String
  title     String
  message   String
  linkUrl   String?
  sent      Int      @default(0)
  createdAt DateTime @default(now())
}

model WebPushSubscription {
  id        String   @id @default(uuid())
  slug      String
  endpoint  String   @unique
  p256dh    String
  auth      String
  // Schema-representation fix only: migration 20260718000000_add_webpush_
  // subscription_cid already applied this nullable column to the real
  // production database; schema.prisma just never caught up. No new
  // migration created here — see docs/architecture/CUSTOMER_FOUNDATION.md.
  cid       String?
  createdAt DateTime @default(now())

  @@index([cid])
}

model StampSettings {
  id         String   @id @default(cuid())
  slug       String   @unique
  goal       Int      @default(10)
  rewardName String   @default("Free item")
  enabled    Boolean  @default(false)
  color      String   @default("#ff5a1f")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt
}

model StampToken {
  id        String   @id @default(cuid())
  slug      String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model StampEntry {
  id        String   @id @default(cuid())
  slug      String
  passId    String
  source    String?
  createdAt DateTime @default(now())
}

model RewardEvent {
  id         String    @id @default(cuid())
  slug       String
  passId     String
  pass       Pass      @relation(fields: [passId], references: [id])
  rewardText String
  status     String    @default("earned")
  createdAt  DateTime  @default(now())
  redeemedAt DateTime?
}

model LoyaltyCustomer {
  id            String    @id @default(cuid())
  slug          String
  customerId    String
  hasWallet     Boolean   @default(false)
  stampCount    Int       @default(0)
  totalStamps   Int       @default(0)
  rewardsEarned Int       @default(0)
  rewardReady   Boolean   @default(false)
  lastStampAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([slug, customerId])
}

// Durable audit log for privileged Operations Center actions (SP3.1).
// metadata is sanitized at the service layer before it ever reaches this
// table — never store passwords, tokens, secrets, cookies, session ids,
// or unnecessary personal data here.
model SupportAction {
  id         String   @id @default(cuid())
  actorId    String
  actorType  String
  actionType String
  targetType String
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

// ============================================================
// Canonical Customer Foundation — Phase 1 (infrastructure only, 2026-08-15).
//
// Corrects an earlier draft of this same foundation (2026-08-11) that
// anchored Customer ownership to `slug` (one landing page). That draft
// was never applied to production and is superseded entirely by this
// version — re-anchored to `ownerUserId` (the authenticated business
// owner / Clerk User.id), which is today's REAL tenant boundary
// (LandingPage.userId), not a single page. This is also the smallest
// upgrade path to the future Brand -> Locations -> Landing Pages
// hierarchy (ADR-004): ownerUserId today is exactly who a future
// Brand's owner would be, so promoting it to a brandId later is a
// straightforward swap, not a redesign. `slug` is kept only as
// optional first-touch/source context, never as the ownership anchor.
//
// Phase 1 is additive infrastructure only:
//   - no customerId/customerRecordId FK added to any existing model
//     (Subscriber, WebPushSubscription, Pass, LoyaltyCustomer,
//     StampEntry, Scan, DealClaim) — that is a later, separate phase
//   - no backfill, no dual-write, no existing behavior changed
//   - CustomerConsent is intentionally NOT part of this targeted
//     deployment (deploy/customer-foundation-phase1-4) — it ships
//     separately, on its own schedule, on the development branch this
//     was cherry-picked from
//
// CustomerChannel (from the superseded draft) is renamed to
// CustomerIdentity here rather than kept as a second, overlapping
// concept — confirmed safe: zero application code referenced
// `prisma.customerChannel` anywhere, so this is a pure rename plus the
// ownerUserId correction, not a breaking change to anything live.
// ============================================================
model Customer {
  id String @id @default(cuid())

  // Tenant anchor. The authenticated business owner (Clerk User.id).
  // Required — every Customer must belong to exactly one business from
  // the moment it's created. This, not slug, is what guarantees
  // customers from different businesses can never collide, and it's
  // what lets one Customer span multiple landing pages owned by the
  // same business.
  ownerUserId String

  // Optional first-touch/source context only — which landing page this
  // identity was first seen on. Never used to decide ownership or
  // collision; ownerUserId alone governs that. Nullable because a
  // future non-page-sourced Customer (e.g. an external CRM import)
  // won't have one.
  slug String?

  displayName            String?
  primaryEmail           String?
  primaryEmailVerifiedAt DateTime?

  status       String  @default("active") // active | merged | anonymized | deleted
  mergedIntoId String?
  source       String?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt
  firstSeenAt    DateTime  @default(now())
  lastActivityAt DateTime?

  identities CustomerIdentity[]

  // Scoped per business, not global — the same real person who is a
  // customer of two unrelated QRAIVY businesses must never collide into
  // one Customer row. NULL primaryEmail values are exempt from this
  // constraint (standard SQL NULL semantics), so many identity-only
  // Customers with no email yet can coexist.
  @@unique([ownerUserId, primaryEmail])
  @@index([ownerUserId])
  @@index([slug])
  @@index([primaryEmail])
}

model CustomerIdentity {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  // Denormalized from the owning Customer, not independently settable —
  // same reasoning as every other tenant-scoped table in this schema.
  // This is what makes the collision guarantee a real DB constraint
  // (below), not just an application-level convention.
  ownerUserId String

  // Optional context: which landing page this specific identity value
  // was captured on. Not part of the uniqueness/collision guarantee —
  // ownerUserId alone governs that, so the same cid/email seen on two
  // different pages owned by the SAME business correctly resolves to
  // one identity row instead of two.
  slug String?

  type       String // "cid" | "email" | "wallet_serial" | "push_endpoint" | "phone" | "whatsapp" | "external_crm"
  // No rows exist yet — Phase 1 creates the table only.
  value      String
  verified   Boolean   @default(false)
  verifiedAt DateTime?
  source     String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now()) @updatedAt

  // Scoped per business (ownerUserId), not per page and not global —
  // the same cid/email appearing on two pages of the SAME business
  // correctly collides into one row (a real same-person signal); the
  // same value appearing under two DIFFERENT businesses never collides
  // (cross-tenant safety), since cid itself is a shared-browser token
  // with no tenant awareness at generation time (see
  // docs/architecture/CUSTOMER_FOUNDATION.md).
  @@unique([ownerUserId, type, value])
  @@index([customerId])
  @@index([slug])
}

// ============================================================
// Network + Location + Business — Stadt Pocket Phase 1A, additive data
// foundation only (2026-08-16). See
// docs/architecture/NETWORK_LOCATION_FOUNDATION.md for the full design.
//
// This layer sits ABOVE Customer Foundation, not inside it. Nothing above
// this comment is touched, and Customer.ownerUserId / CustomerIdentity.
// ownerUserId keep their exact current meaning and scoping — unchanged.
//
// Business is the new canonical tenant entity, deliberately separate from
// the Clerk User (authenticated principal). `Business.primaryOwnerUserId`
// is the SAME value already used everywhere as ownerUserId/userId — kept
// as a bare column (not a Prisma relation), matching the existing
// LandingPage.userId convention: this schema has never modeled `User` as
// a Prisma relation target, so this doesn't invent a new pattern.
//
// Legacy ownerUserId/userId scoping remains authoritative on every
// existing table during this compatibility period — nothing here is
// required, nothing here is read by any existing route yet.
// ============================================================

model Network {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  // "city_network" | "mall_group" | "generic" — free-text by design, same
  // convention as every other type/status column in this schema (e.g.
  // LandingPage.qrType, Customer.status) — no enum type exists anywhere
  // in this schema; not introducing one here.
  type      String   @default("generic")
  status    String   @default("active") // active | paused
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  locations      Location[]
  networkMembers NetworkMember[]
}

model Location {
  id        String   @id @default(cuid())
  networkId String
  network   Network  @relation(fields: [networkId], references: [id])
  name      String
  slug      String   @unique
  type      String   @default("generic") // "city" | "mall" | "district" | "generic"
  status    String   @default("active") // active | paused
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  businessLocations BusinessLocation[]
  networkMembers    NetworkMember[]

  @@index([networkId])
}

model Business {
  id   String  @id @default(cuid())
  name String
  // Nullable — unlike LandingPage.slug, most Businesses (especially the
  // compatibility-backfill shim rows for existing accounts) have no
  // natural public slug to assign; never inventing one.
  slug String? @unique

  // The canonical scoping anchor for backward compatibility: the exact
  // same Clerk user id already used as ownerUserId/userId everywhere else
  // in this schema. Every existing single-owner account maps to exactly
  // one Business with primaryOwnerUserId = that account's own id.
  primaryOwnerUserId String

  status    String   @default("active") // active | paused | archived
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  members           BusinessMember[]
  businessLocations BusinessLocation[]
  landingPages      LandingPage[]

  @@index([primaryOwnerUserId])
}

model BusinessMember {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  userId     String // Clerk user id
  role       String   @default("owner") // "owner" | "staff"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  // The same Clerk user can never accidentally receive duplicate
  // membership in the same Business.
  @@unique([businessId, userId])
  @@index([userId])
}

// Join: which Location(s) a Business participates in. A Location has many
// Businesses; a Business may participate in multiple Locations (this is
// also how a future multi-outlet brand — ADR-004's Brand -> Locations
// direction — is represented, without a second competing hierarchy: a
// Business with several BusinessLocation rows IS a multi-outlet brand).
// Minimum relationship only — no promotional/billing fields yet.
model BusinessLocation {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  locationId String
  location   Location @relation(fields: [locationId], references: [id])
  status     String   @default("active") // active | paused
  joinedAt   DateTime @default(now())

  @@unique([businessId, locationId])
  @@index([locationId])
}

// Future permission relationship (data structure only — no middleware
// reads this yet, see docs/architecture/NETWORK_LOCATION_FOUNDATION.md).
// locationId = null means network-wide access (e.g. Stadt Pocket HQ);
// locationId set means access scoped to exactly that one Location (e.g. a
// single city manager). Known limitation, documented rather than silently
// left unhandled: Postgres unique constraints do not deduplicate multiple
// rows sharing the same (userId, networkId) when locationId is NULL (NULL
// is never equal to NULL) — enforcing "at most one network-wide grant per
// user" is deferred to the Phase 3 service layer that actually creates
// these rows, not solved with a partial index here, to avoid enabling a
// new Prisma preview feature for a case with no real-world duplicate-
// grant risk (redundant, not insecure) this early.
model NetworkMember {
  id         String    @id @default(cuid())
  userId     String // Clerk user id
  networkId  String
  network    Network   @relation(fields: [networkId], references: [id])
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id])
  role       String // "network_admin" | "location_manager"
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt

  @@unique([userId, networkId, locationId])
  @@index([userId])
  @@index([networkId])
}
