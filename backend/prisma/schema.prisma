generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id
  email     String?
  phone     String?
  plan      String   @default("free")
  createdAt        DateTime  @default(now())
  trialExpiresAt   DateTime?
  accountType      String?   @default("free")
  stripeCustomerId     String?
  stripeSubscriptionId String?
  subscriptionStatus   String?
  qrs       QR[]
}

model QR {
  id             String       @id @default(uuid())
  originalUrl    String
  businessName   String?
  siteContent    String?
  userId         String?
  isDynamic      Boolean      @default(false)
  destinationUrl String?
  createdAt      DateTime     @default(now())
  user           User?        @relation(fields: [userId], references: [id])
  lastScannedAt  DateTime?
  scans          Scan[]
  subscribers    Subscriber[]
}

model Scan {
  id        String   @id @default(uuid())
  qrId      String
  userAgent String
  ip        String?
  referer   String?
  createdAt DateTime @default(now())
  qr        QR       @relation(fields: [qrId], references: [id])
}

model Subscriber {
  id          String   @id @default(uuid())
  qrId        String
  oneSignalId String
  createdAt   DateTime @default(now())
  qr          QR       @relation(fields: [qrId], references: [id])
}

model LandingPage {
  id           String   @id @default(uuid())
  slug         String   @unique
  businessName String
  websiteUrl   String?
  useCase      String?
  brandColor   String?  @default("#ff5a1f")
  logoUrl      String?
  userId       String?
  qrType       String?  @default("ai")
  sections     String?
  status       String   @default("live")
  scanCount    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
}

model Pass {
  id            String             @id @default(cuid())
  serialNumber  String             @unique
  passTypeId    String
  authToken     String?
  updatedAt     DateTime           @default(now()) @updatedAt
  devices       PassDevice[]
  registrations PassRegistration[]
}

model PassDevice {
  id                    String   @id @default(cuid())
  deviceLibraryId       String
  pushToken             String
  walletType            String   @default("apple")
  passId                String
  pass                  Pass     @relation(fields: [passId], references: [id])
  createdAt             DateTime @default(now())
  @@unique([passId, deviceLibraryId])
}

model PassRegistration {
  id                    String   @id @default(cuid())
  deviceLibraryId       String
  serialNumber          String
  passId                String
  pass                  Pass     @relation(fields: [passId], references: [id])
  createdAt             DateTime @default(now())
}
