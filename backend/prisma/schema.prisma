generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id
  email     String?
  phone     String?
  plan      String   @default("free")
  createdAt        DateTime  @default(now())
  trialExpiresAt   DateTime?
  accountType      String?   @default("free")
  stripeCustomerId     String?
  stripeSubscriptionId String?
  subscriptionStatus   String?
  qrs       QR[]

  @@index([email])
}

model QR {
  id             String       @id @default(uuid())
  originalUrl    String
  businessName   String?
  siteContent    String?
  userId         String?
  isDynamic      Boolean      @default(false)
  destinationUrl String?
  createdAt      DateTime     @default(now())
  user           User?        @relation(fields: [userId], references: [id])
  lastScannedAt  DateTime?
  scans          Scan[]
  subscribers    Subscriber[]

  @@index([businessName])
}

model Scan {
  id        String   @id @default(uuid())
  qrId      String
  userAgent String
  ip        String?
  referer   String?
  createdAt DateTime @default(now())
  qr        QR       @relation(fields: [qrId], references: [id])
}

model Subscriber {
  id              String    @id @default(uuid())
  qrId            String?
  slug            String?
  oneSignalId     String?
  email           String?
  gdprConsent     Boolean   @default(false)
  userId          String?
  status          String    @default("subscribed")
  source          String    @default("email")
  subscribedAt    DateTime  @default(now())
  unsubscribedAt  DateTime?
  resendContactId String?
  // Email Unsubscribe Phase B1 (double opt-in, 2026-08-12): when the
  // subscriber's *current* consent cycle was cryptographically confirmed
  // via the double-opt-in link. Null on every pre-existing row (no DOI
  // evidence was ever collected for them — never fabricated) and reset to
  // null whenever a subscriber re-enters 'pending' (an old confirmation
  // proves a consent that has since been withdrawn, not the current one).
  // A status:'subscribed' row with confirmedAt:null is a legacy,
  // pre-DOI-confirmed subscriber; one with confirmedAt set went through
  // double opt-in. This single nullable field is the entire B1 evidence
  // model — no separate consent-history/versioning storage yet (Phase B2).
  confirmedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt
  qr              QR?       @relation(fields: [qrId], references: [id])
  // Consent Evidence Phase B2A: reverse relation only, no new column on
  // Subscriber itself.
  consents        CustomerConsent[]

  @@index([slug])
  @@index([userId])
  @@index([status])
}

model LandingPage {
  id           String   @id @default(uuid())
  slug         String   @unique
  businessName String
  websiteUrl   String?
  useCase      String?
  brandColor   String?  @default("#ff5a1f")
  logoUrl      String?
  userId       String?
  qrType       String?  @default("ai")
  sections     String?
  template     String?
  status       String   @default("live")
  scanCount    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  @@index([businessName])
}

model Pass {
  id              String             @id @default(cuid())
  serialNumber    String             @unique
  // Set at creation time. serialNumber encodes slug + an optional customer
  // cid as "sqr-{slug}-{cid}", but slugs themselves contain hyphens, so
  // reverse-parsing the slug back out of serialNumber is ambiguous —
  // storing it directly is the only reliable way to look up which
  // landing page a given Pass belongs to.
  slug            String?
  passTypeId      String
  authToken       String?
  lastMsgTitle    String?
  lastMsg         String?
  lastMsgLink     String?
  stampCount      Int                @default(0)
  stampGoal       Int                @default(10)
  rewardReady     Boolean            @default(false)
  totalStamps     Int                @default(0)
  rewardsEarned   Int                @default(0)
  lastStampAt     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @default(now()) @updatedAt
  devices         PassDevice[]
  registrations   PassRegistration[]
  rewardEvents    RewardEvent[]

  // Architecture B, Stage A: optional link to the canonical cross-context
  // identity. Nullable and additive — existing rows and every current
  // code path are unaffected until a later stage backfills this and
  // switches resolution logic over. See docs/WORKLOG.md 2026-07-26.
  loyaltyCustomerId String?
  loyaltyCustomer   LoyaltyCustomer? @relation(fields: [loyaltyCustomerId], references: [id], onDelete: Restrict)

  @@index([loyaltyCustomerId])
}

model PassDevice {
  id                    String   @id @default(cuid())
  deviceLibraryId       String
  pushToken             String
  walletType            String   @default("apple")
  passId                String
  pass                  Pass     @relation(fields: [passId], references: [id])
  createdAt             DateTime @default(now())
  @@unique([passId, deviceLibraryId])
}

model PassRegistration {
  id                    String   @id @default(cuid())
  deviceLibraryId       String
  serialNumber          String
  passId                String
  pass                  Pass     @relation(fields: [passId], references: [id])
  createdAt             DateTime @default(now())
}

model PushCampaign {
  id           String   @id @default(cuid())
  slug         String
  title        String
  message      String
  linkUrl      String?
  sent         Int      @default(0)
  createdAt    DateTime @default(now())
}

model WebPushSubscription {
  id        String   @id @default(uuid())
  slug      String
  endpoint  String   @unique
  p256dh    String
  auth      String
  // Universal anonymous customer identifier (same "cTok" value used by
  // Pass/LoyaltyCustomer via req.body.cid) — links a push subscription to
  // its owning customer for audience segmentation. Nullable: older rows
  // predate this column, and subscriptions can still be created without it.
  cid       String?
  createdAt DateTime @default(now())

  @@index([cid])
}
model StampSettings {
  id          String   @id @default(cuid())
  slug        String   @unique
  goal        Int      @default(10)
  rewardName  String   @default("Free item")
  enabled     Boolean  @default(false)
  color       String   @default("#ff5a1f")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
}

model StampToken {
  id        String   @id @default(cuid())
  slug      String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model StampEntry {
  id        String   @id @default(cuid())
  slug      String
  passId    String
  source    String?
  createdAt DateTime @default(now())
}

model RewardEvent {
  id          String    @id @default(cuid())
  slug        String
  passId      String
  pass        Pass      @relation(fields: [passId], references: [id])
  rewardText  String
  status      String    @default("earned")
  createdAt   DateTime  @default(now())
  redeemedAt  DateTime?
}

model LoyaltyCustomer {
  id            String    @id @default(cuid())
  slug          String
  customerId    String
  hasWallet     Boolean   @default(false)
  stampCount    Int       @default(0)
  totalStamps   Int       @default(0)
  rewardsEarned Int       @default(0)
  rewardReady   Boolean   @default(false)
  lastStampAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Architecture B, Stage A: additive only. LoyaltyCustomer.customerId
  // (above) is left exactly as-is — it remains a real, independently
  // fragmented per-cid row today (confirmed via production data review,
  // 2026-07-26: every cid seen on a Pass.serialNumber for a given slug
  // has its own LoyaltyCustomer row). These two relations are the new
  // many-to-one layer that lets a single canonical LoyaltyCustomer be
  // resolved from multiple cids going forward, without changing what
  // customerId means or how any existing code reads/writes it.
  passes  Pass[]
  aliases LoyaltyCustomerAlias[]

  @@unique([slug, customerId])
}

// Architecture B, Stage A: new, additive-only table. Every cid ever
// resolved for a given slug maps to exactly one canonical LoyaltyCustomer;
// a LoyaltyCustomer can have many aliases (one per browser/app storage
// context that ever independently minted a cid for the same physical
// customer). Restrict (not Cascade) delete: future reconciliation logic
// that merges duplicate LoyaltyCustomer rows must explicitly reassign
// (UPDATE) a loser's aliases to the winner before that row can be
// deleted — deleting a LoyaltyCustomer that still has aliases pointing
// at it must fail loudly, never silently discard alias history.
model LoyaltyCustomerAlias {
  id                String          @id @default(cuid())
  loyaltyCustomerId String
  loyaltyCustomer   LoyaltyCustomer @relation(fields: [loyaltyCustomerId], references: [id], onDelete: Restrict)
  slug              String
  cid               String
  createdAt         DateTime        @default(now())
  lastSeenAt        DateTime        @default(now()) @updatedAt

  @@unique([slug, cid])
  @@index([loyaltyCustomerId])
}

// Durable audit log for privileged Operations Center actions (SP3.1).
// metadata is sanitized at the service layer before it ever reaches this
// table — never store passwords, tokens, secrets, cookies, session ids,
// or unnecessary personal data here.
model SupportAction {
  id         String   @id @default(cuid())
  actorId    String
  actorType  String
  actionType String
  targetType String
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

// ============================================================
// Consent Evidence — Phase B2A (standalone, 2026-08-13).
//
// Deliberately independent of Customer Foundation (Customer/
// CustomerChannel), which has NOT been applied to production. No
// customerRecordId, no channelId — those are additive future links, added
// only once Customer Foundation itself is deployed. Referencing only
// Subscriber (already in production) keeps this migration safely
// deployable against today's actual production schema.
//
// One row per consent CYCLE, not one row per Subscriber: a
// pending->active transition updates the same row; an active->withdrawn
// transition updates the same row and then that row is frozen forever;
// a NEW cycle (first signup, or re-subscribe after unsubscribe) always
// creates a NEW row. Withdrawn rows are never revived or mutated again —
// this is what lets CustomerConsent answer "when did they first
// withdraw" even after a later resubscribe, which Subscriber's own
// single mutable row structurally cannot.
// ============================================================
model CustomerConsent {
  id            String    @id @default(cuid())

  // Collision-safety anchor, denormalized directly here — same
  // reasoning as every other slug-scoped table in this schema. Must
  // remain trustworthy on its own since there is no Customer/
  // CustomerChannel link in B2A.
  slug          String

  purpose       String    // "email_marketing" only for B2. Plain string,
                           // not a DB enum, so a future purpose needs no
                           // migration to add.

  status        String    // "pending" | "active" | "withdrawn"
  method        String?   // "double_opt_in_v1" | "legacy" | null (pending)
  policyVersion String?   // e.g. "EMAIL_MARKETING_V1_DE" -- points at a
                           // code-level wording constant, never stores
                           // the rendered copy itself.

  requestedAt   DateTime  // start of this consent cycle
  confirmedAt   DateTime?
  withdrawnAt   DateTime?
  source        String?   // e.g. "landing_page_signup"

  // The operational Subscriber row this evidence was derived from.
  // Many-to-one, not 1:1 -- a single Subscriber accumulates multiple
  // CustomerConsent rows over its lifetime (one per consent cycle).
  subscriberId  String?
  subscriber    Subscriber? @relation(fields: [subscriberId], references: [id])

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  @@index([slug, purpose])
  @@index([subscriberId])
}
