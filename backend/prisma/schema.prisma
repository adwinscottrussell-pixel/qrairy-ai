generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String    @id
  email                String?
  phone                String?
  plan                 String    @default("free")
  createdAt            DateTime  @default(now())
  trialExpiresAt       DateTime?
  accountType          String?   @default("free")
  stripeCustomerId     String?
  stripeSubscriptionId String?
  subscriptionStatus   String?
  qrs                  QR[]

  @@index([email])
}

model QR {
  id             String       @id @default(uuid())
  originalUrl    String
  businessName   String?
  siteContent    String?
  userId         String?
  isDynamic      Boolean      @default(false)
  destinationUrl String?
  createdAt      DateTime     @default(now())
  user           User?        @relation(fields: [userId], references: [id])
  lastScannedAt  DateTime?
  scans          Scan[]
  subscribers    Subscriber[]

  @@index([businessName])
}

model Scan {
  id        String   @id @default(uuid())
  qrId      String
  userAgent String
  ip        String?
  referer   String?
  createdAt DateTime @default(now())
  qr        QR       @relation(fields: [qrId], references: [id])
}

model Subscriber {
  id              String    @id @default(uuid())
  qrId            String?
  slug            String?
  oneSignalId     String?
  email           String?
  gdprConsent     Boolean   @default(false)
  userId          String?
  status          String    @default("subscribed")
  source          String    @default("email")
  subscribedAt    DateTime  @default(now())
  unsubscribedAt  DateTime?
  resendContactId String?
  // Email Unsubscribe Phase B1 (double opt-in, 2026-08-12): when the
  // subscriber's *current* consent cycle was cryptographically confirmed
  // via the double-opt-in link. Null on every pre-existing row (no DOI
  // evidence was ever collected for them — never fabricated) and reset to
  // null whenever a subscriber re-enters 'pending' (an old confirmation
  // proves a consent that has since been withdrawn, not the current one).
  // A status:'subscribed' row with confirmedAt:null is a legacy,
  // pre-DOI-confirmed subscriber; one with confirmedAt set went through
  // double opt-in. This single nullable field is the entire B1 evidence
  // model — no separate consent-history/versioning storage yet (Phase B2).
  confirmedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt
  qr              QR?       @relation(fields: [qrId], references: [id])
  // Consent Evidence Phase B2A: reverse relation only, no new column on
  // Subscriber itself.
  consents        CustomerConsent[]

  @@index([slug])
  @@index([userId])
  @@index([status])
}

model LandingPage {
  id           String   @id @default(uuid())
  slug         String   @unique
  businessName String
  websiteUrl   String?
  useCase      String?
  brandColor   String?  @default("#ff5a1f")
  logoUrl      String?
  userId       String?
  qrType       String?  @default("ai")
  sections     String?
  template     String?
  status       String   @default("live")
  scanCount    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  @@index([businessName])
}

// ============================================================
// Deals (Phase 1A) — schema and CRUD only. No claim/redemption
// endpoints, no public pages, no push, no analytics yet.
//
// Status/redemptionType/claim-status are plain Strings, not Prisma
// enums. Postgres (this datasource's provider) supports native enums,
// but every existing status-like field in this schema (LandingPage.status,
// Subscriber.status, RewardEvent.status, StampSettings.*, etc.) is a
// plain String — following that established convention rather than
// introducing the first enum. Allowed values are validated centrally in
// services/dealValidation.js, not enforced by the database.
//
// landingPageSlug is a bare string, not a Prisma relation field — matching
// the existing convention already used by StampSettings, StampToken, Pass,
// LoyaltyCustomer, and WebPushSubscription, all of which join to
// LandingPage by slug rather than a real foreign key.
// ============================================================
model Deal {
  id               String      @id @default(cuid())
  // Immutable public identifier — generated server-side only (see
  // dealController.js), never accepted from the client. Intended for
  // stable hosted URLs, QR codes, push links, and analytics, independent
  // of title/slug so renaming a deal never breaks a link already handed
  // out to a customer.
  publicId         String      @unique
  landingPageSlug  String
  slug             String
  title            String
  shortDescription String
  fullDescription  String
  imageUrl         String?
  ctaLabel         String      @default("Claim Deal")
  startAt          DateTime
  endAt            DateTime?
  status           String      @default("draft") // draft | scheduled | live | paused | expired
  redemptionType   String      @default("single_use") // single_use | unlimited
  redemptionLimit  Int?
  terms            String?
  originalPrice    Float?
  dealPrice        Float?
  discountText     String?
  pushMessage      String?
  featured         Boolean     @default(false)
  // Reserved placeholder for a future Location model. Must hold a stable
  // identifier (a future Location.id), never a free-text display name
  // like "Downtown Store" — no Location/Brand model exists yet, and
  // nothing in Phase 1A reads or writes this field.
  locationRef      String?
  viewCount        Int         @default(0)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @default(now()) @updatedAt
  claims           DealClaim[]

  // Slug uniqueness is scoped per landing page, not global — two different
  // businesses (or two different pages) may each have their own "summer-sale".
  @@unique([landingPageSlug, slug])
  @@index([landingPageSlug])
}

// The complete lifecycle of one customer's interaction with a Deal — claim
// and redemption are two states of the same row, not two tables (see
// docs/API_REFERENCE.md for the full rationale). No DealRedemption model.
model DealClaim {
  id                  String    @id @default(cuid())
  dealId              String
  deal                Deal      @relation(fields: [dealId], references: [id])
  // Anonymous customer identity ("cTok"), same convention as
  // WebPushSubscription.cid / LoyaltyCustomer.customerId. Nullable —
  // staff-initiated redemptions (a future phase) may have no customer
  // identity captured at all.
  cid                 String?
  // Redemption credential. Generated server-side only, unique, never
  // accepted from the client. Not used by any Phase 1A code (no
  // claim/redemption endpoints yet) but included now so the unique
  // constraint and index exist before that logic is built.
  token               String    @unique
  status              String    @default("claimed") // claimed | redeemed | void
  claimedAt           DateTime  @default(now())
  redeemedAt          DateTime?
  // Stable identifier for whoever performed the redemption (e.g. a future
  // staff-session/PIN-verification id) — never a free-text name. Not
  // client-writable. Unused by any Phase 1A code.
  redeemedBy          String?
  // Same convention as Deal.locationRef — a future Location.id, not a
  // display name. Unused by any Phase 1A code.
  redeemedLocationRef String?
  expiresAt           DateTime?

  // Deliberately NOT @@unique([dealId, cid]) — whether a customer may claim
  // the same deal more than once depends on redemptionType (a business
  // rule), not a database invariant. Enforced in application logic when
  // the claim endpoint is built in a later phase.
  @@index([dealId])
  @@index([cid])
}

model Pass {
  id            String             @id @default(cuid())
  serialNumber  String             @unique
  // Set at creation time. serialNumber encodes slug + an optional customer
  // cid as "sqr-{slug}-{cid}", but slugs themselves contain hyphens, so
  // reverse-parsing the slug back out of serialNumber is ambiguous —
  // storing it directly is the only reliable way to look up which
  // landing page a given Pass belongs to.
  slug          String?
  passTypeId    String
  authToken     String?
  lastMsgTitle  String?
  lastMsg       String?
  lastMsgLink   String?
  stampCount    Int                @default(0)
  stampGoal     Int                @default(10)
  rewardReady   Boolean            @default(false)
  totalStamps   Int                @default(0)
  rewardsEarned Int                @default(0)
  lastStampAt   DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @default(now()) @updatedAt
  devices       PassDevice[]
  registrations PassRegistration[]
  rewardEvents  RewardEvent[]

  // Architecture B, Stage A: optional link to the canonical cross-context
  // identity. Nullable and additive — existing rows and every current
  // code path are unaffected until a later stage backfills this and
  // switches resolution logic over. See docs/WORKLOG.md 2026-07-26.
  loyaltyCustomerId String?
  loyaltyCustomer   LoyaltyCustomer? @relation(fields: [loyaltyCustomerId], references: [id], onDelete: Restrict)

  @@index([loyaltyCustomerId])
}

model PassDevice {
  id              String   @id @default(cuid())
  deviceLibraryId String
  pushToken       String
  walletType      String   @default("apple")
  passId          String
  pass            Pass     @relation(fields: [passId], references: [id])
  createdAt       DateTime @default(now())

  @@unique([passId, deviceLibraryId])
}

model PassRegistration {
  id              String   @id @default(cuid())
  deviceLibraryId String
  serialNumber    String
  passId          String
  pass            Pass     @relation(fields: [passId], references: [id])
  createdAt       DateTime @default(now())
}

model PushCampaign {
  id        String   @id @default(cuid())
  slug      String
  title     String
  message   String
  linkUrl   String?
  sent      Int      @default(0)
  createdAt DateTime @default(now())
}

model WebPushSubscription {
  id        String   @id @default(uuid())
  slug      String
  endpoint  String   @unique
  p256dh    String
  auth      String
  // Universal anonymous customer identifier (same "cTok" value used by
  // Pass/LoyaltyCustomer via req.body.cid) — links a push subscription to
  // its owning customer for audience segmentation. Nullable: older rows
  // predate this column, and subscriptions can still be created without it.
  cid       String?
  createdAt DateTime @default(now())

  @@index([cid])
}

model StampSettings {
  id         String   @id @default(cuid())
  slug       String   @unique
  goal       Int      @default(10)
  rewardName String   @default("Free item")
  enabled    Boolean  @default(false)
  color      String   @default("#ff5a1f")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt
}

model StampToken {
  id        String   @id @default(cuid())
  slug      String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model StampEntry {
  id        String   @id @default(cuid())
  slug      String
  passId    String
  source    String?
  createdAt DateTime @default(now())
}

model RewardEvent {
  id         String    @id @default(cuid())
  slug       String
  passId     String
  pass       Pass      @relation(fields: [passId], references: [id])
  rewardText String
  status     String    @default("earned")
  createdAt  DateTime  @default(now())
  redeemedAt DateTime?
}

model LoyaltyCustomer {
  id            String    @id @default(cuid())
  slug          String
  customerId    String
  hasWallet     Boolean   @default(false)
  stampCount    Int       @default(0)
  totalStamps   Int       @default(0)
  rewardsEarned Int       @default(0)
  rewardReady   Boolean   @default(false)
  lastStampAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Architecture B, Stage A: additive only. LoyaltyCustomer.customerId
  // (above) is left exactly as-is — it remains a real, independently
  // fragmented per-cid row today (confirmed via production data review,
  // 2026-07-26: every cid seen on a Pass.serialNumber for a given slug
  // has its own LoyaltyCustomer row). These two relations are the new
  // many-to-one layer that lets a single canonical LoyaltyCustomer be
  // resolved from multiple cids going forward, without changing what
  // customerId means or how any existing code reads/writes it.
  passes  Pass[]
  aliases LoyaltyCustomerAlias[]

  @@unique([slug, customerId])
}

// Architecture B, Stage A: new, additive-only table. Every cid ever
// resolved for a given slug maps to exactly one canonical LoyaltyCustomer;
// a LoyaltyCustomer can have many aliases (one per browser/app storage
// context that ever independently minted a cid for the same physical
// customer). Restrict (not Cascade) delete: future reconciliation logic
// that merges duplicate LoyaltyCustomer rows must explicitly reassign
// (UPDATE) a loser's aliases to the winner before that row can be
// deleted — deleting a LoyaltyCustomer that still has aliases pointing
// at it must fail loudly, never silently discard alias history.
model LoyaltyCustomerAlias {
  id                String          @id @default(cuid())
  loyaltyCustomerId String
  loyaltyCustomer   LoyaltyCustomer @relation(fields: [loyaltyCustomerId], references: [id], onDelete: Restrict)
  slug              String
  cid               String
  createdAt         DateTime        @default(now())
  lastSeenAt        DateTime        @default(now()) @updatedAt

  @@unique([slug, cid])
  @@index([loyaltyCustomerId])
}

// Durable audit log for privileged Operations Center actions (SP3.1).
// metadata is sanitized at the service layer before it ever reaches this
// table — never store passwords, tokens, secrets, cookies, session ids,
// or unnecessary personal data here.
model SupportAction {
  id         String   @id @default(cuid())
  actorId    String
  actorType  String
  actionType String
  targetType String
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

// ============================================================
// Canonical Customer Foundation — Phase 1 (infrastructure only, 2026-08-15).
//
// Corrects an earlier draft of this same foundation (2026-08-11) that
// anchored Customer ownership to `slug` (one landing page). That draft
// was never applied to production and is superseded entirely by this
// version — re-anchored to `ownerUserId` (the authenticated business
// owner / Clerk User.id), which is today's REAL tenant boundary
// (LandingPage.userId), not a single page. This is also the smallest
// upgrade path to the future Brand -> Locations -> Landing Pages
// hierarchy (ADR-004): ownerUserId today is exactly who a future
// Brand's owner would be, so promoting it to a brandId later is a
// straightforward swap, not a redesign. `slug` is kept only as
// optional first-touch/source context, never as the ownership anchor.
//
// Phase 1 is additive infrastructure only:
//   - no customerId/customerRecordId FK added to any existing model
//     (Subscriber, WebPushSubscription, Pass, LoyaltyCustomer,
//     StampEntry, Scan, DealClaim) — that is a later, separate phase
//   - no backfill, no dual-write, no existing behavior changed
//   - CustomerConsent (already in production) is untouched and NOT
//     linked here yet — same reasoning as the comment below it already
//     documents
//
// CustomerChannel (from the superseded draft) is renamed to
// CustomerIdentity here rather than kept as a second, overlapping
// concept — confirmed safe: zero application code referenced
// `prisma.customerChannel` anywhere, so this is a pure rename plus the
// ownerUserId correction, not a breaking change to anything live.
// ============================================================
model Customer {
  id String @id @default(cuid())

  // Tenant anchor. The authenticated business owner (Clerk User.id).
  // Required — every Customer must belong to exactly one business from
  // the moment it's created. This, not slug, is what guarantees
  // customers from different businesses can never collide, and it's
  // what lets one Customer span multiple landing pages owned by the
  // same business.
  ownerUserId String

  // Optional first-touch/source context only — which landing page this
  // identity was first seen on. Never used to decide ownership or
  // collision; ownerUserId alone governs that. Nullable because a
  // future non-page-sourced Customer (e.g. an external CRM import)
  // won't have one.
  slug String?

  displayName  String?
  primaryEmail String?
  primaryEmailVerifiedAt DateTime?

  status       String  @default("active") // active | merged | anonymized | deleted
  mergedIntoId String?
  source       String?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt
  firstSeenAt    DateTime  @default(now())
  lastActivityAt DateTime?

  identities CustomerIdentity[]

  @@index([ownerUserId])
  @@index([slug])
  @@index([primaryEmail])
  // Scoped per business, not global — the same real person who is a
  // customer of two unrelated QRAIVY businesses must never collide into
  // one Customer row. NULL primaryEmail values are exempt from this
  // constraint (standard SQL NULL semantics), so many identity-only
  // Customers with no email yet can coexist.
  @@unique([ownerUserId, primaryEmail])
}

model CustomerIdentity {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  // Denormalized from the owning Customer, not independently settable —
  // same reasoning as every other tenant-scoped table in this schema.
  // This is what makes the collision guarantee a real DB constraint
  // (below), not just an application-level convention.
  ownerUserId String

  // Optional context: which landing page this specific identity value
  // was captured on. Not part of the uniqueness/collision guarantee —
  // ownerUserId alone governs that, so the same cid/email seen on two
  // different pages owned by the SAME business correctly resolves to
  // one identity row instead of two.
  slug String?

  type String // "cid" | "email" | "wallet_serial" | "push_endpoint" | "phone" | "whatsapp" | "external_crm"
              // No rows exist yet — Phase 1 creates the table only.
  value      String
  verified   Boolean   @default(false)
  verifiedAt DateTime?
  source     String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now()) @updatedAt

  // Scoped per business (ownerUserId), not per page and not global —
  // the same cid/email appearing on two pages of the SAME business
  // correctly collides into one row (a real same-person signal); the
  // same value appearing under two DIFFERENT businesses never collides
  // (cross-tenant safety), since cid itself is a shared-browser token
  // with no tenant awareness at generation time (see
  // docs/architecture/CUSTOMER_FOUNDATION.md).
  @@unique([ownerUserId, type, value])
  @@index([customerId])
  @@index([slug])
}

// ============================================================
// Consent Evidence — Phase B2A (standalone, 2026-08-13).
//
// Deliberately independent of Customer Foundation (Customer/
// CustomerChannel), which has NOT been applied to production. No
// customerRecordId, no channelId — those are additive future links, added
// only once Customer Foundation itself is deployed. Referencing only
// Subscriber (already in production) keeps this migration safely
// deployable against today's actual production schema.
//
// One row per consent CYCLE, not one row per Subscriber: a
// pending->active transition updates the same row; an active->withdrawn
// transition updates the same row and then that row is frozen forever;
// a NEW cycle (first signup, or re-subscribe after unsubscribe) always
// creates a NEW row. Withdrawn rows are never revived or mutated again —
// this is what lets CustomerConsent answer "when did they first
// withdraw" even after a later resubscribe, which Subscriber's own
// single mutable row structurally cannot.
// ============================================================
model CustomerConsent {
  id            String    @id @default(cuid())

  // Collision-safety anchor, denormalized directly here — same
  // reasoning as every other slug-scoped table in this schema. Must
  // remain trustworthy on its own since there is no Customer/
  // CustomerChannel link in B2A.
  slug          String

  purpose       String    // "email_marketing" only for B2. Plain string,
                           // not a DB enum, so a future purpose needs no
                           // migration to add.

  status        String    // "pending" | "active" | "withdrawn"
  method        String?   // "double_opt_in_v1" | "legacy" | null (pending)
  policyVersion String?   // e.g. "EMAIL_MARKETING_V1_DE" -- points at a
                           // code-level wording constant, never stores
                           // the rendered copy itself.

  requestedAt   DateTime  // start of this consent cycle
  confirmedAt   DateTime?
  withdrawnAt   DateTime?
  source        String?   // e.g. "landing_page_signup"

  // The operational Subscriber row this evidence was derived from.
  // Many-to-one, not 1:1 -- a single Subscriber accumulates multiple
  // CustomerConsent rows over its lifetime (one per consent cycle).
  subscriberId  String?
  subscriber    Subscriber? @relation(fields: [subscriberId], references: [id])

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  @@index([slug, purpose])
  @@index([subscriberId])
}
